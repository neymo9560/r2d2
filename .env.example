# ============================================
# R2D2 Bot - Configuration Sécurisée
# ============================================
# COPIE ce fichier en .env et remplis tes clés !
# JAMAIS commit ton .env sur GitHub !

# ============================================
# HYPERLIQUID API
# ============================================
# Ta clé privée pour signer les trades (format hex sans 0x)
# ATTENTION : Garde ça ULTRA SECRET !
PRIVATE_KEY=ta_cle_privee_ici_sans_0x

# Adresse de ton wallet (format 0x...)
WALLET_ADDRESS=0xTonAdresseWalletIci

# ============================================
# INFURA (Provider Arbitrum)
# ============================================
# Crée un compte gratuit sur infura.io et copie l'URL
# Testnet Arbitrum Sepolia (chain 421614)
INFURA_URL_TESTNET=https://arbitrum-sepolia.infura.io/v3/TA_CLE_INFURA

# Mainnet Arbitrum One (chain 42161)
INFURA_URL_MAINNET=https://arbitrum-mainnet.infura.io/v3/TA_CLE_INFURA

# ============================================
# MODE BOT
# ============================================
# true = mainnet (argent réel!), false = testnet (paper)
MAINNET_MODE=false

# ============================================
# MOTS DE PASSE UI
# ============================================
# Mode Contrôle (full access)
PASSWORD_CONTROL=Bine

# Mode Viewer (lecture seule)
PASSWORD_VIEWER=Bina
